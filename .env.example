# Local Hermes/NapCat bridge configuration.
# Copy to .env and replace every placeholder locally. Never commit .env.

DRIVER=~fastapi+~httpx
HOST=127.0.0.1
PORT=8080

# Hermes API
HERMES_URL=http://127.0.0.1:8650
HERMES_KEY=replace-with-local-secret
HERMES_GROUP_URL=http://127.0.0.1:8650
HERMES_GROUP_KEY=replace-with-local-secret

# OneBot/NapCat
ONEBOT_API_ROOT=http://127.0.0.1:18801
ONEBOT_V11_API_ROOTS={}
QQ_GROUP_WHITELIST=1108551011
QQ_ALLOWED_USERS=

# Runtime directories
QQ_BRIDGE_FILE_DIR=/tmp/hermes-qq-bridge-files
QQ_BRIDGE_LOG_DIR=/tmp/hermes-qq-bridge-logs

# Behavior defaults
QQ_GROUP_WINDOW_SIZE=20
QQ_GROUP_DEBOUNCE_SECONDS=4.0
QQ_GROUP_MAX_BATCH_SECONDS=12.0
QQ_GROUP_SMALLTALK_PROBABILITY=0.12
QQ_EMOJI_REACT_ON_REPLY=1
QQ_EMOJI_ID=76
